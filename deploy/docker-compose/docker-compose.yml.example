services:
  # Metadata Consensus Cluster (3 Nodes)
  metadata-1:
    build:
      context: ../../
      dockerfile: deploy/docker/Dockerfile
      target: metadata-svc
    image: castor-metadata-svc:latest
    container_name: castor-metadata-1
    environment:
      - NODE_ID=${METADATA_1_NODE_ID:-metadata-1}
      - GRPC_ADDR=${METADATA_1_GRPC_ADDR:-:9090}
      - RAFT_ADDR=${METADATA_1_RAFT_ADDR:-metadata-1:9091}
      - METRICS_ADDR=${METADATA_1_METRICS_ADDR:-:9096}
      - DATA_DIR=${METADATA_1_DATA_DIR:-/data}
      - RAFT_BOOTSTRAP=true
      - RAFT_PEERS=${RAFT_PEERS:-metadata-1=metadata-1:9091,metadata-2=metadata-2:9091,metadata-3=metadata-3:9091}
      - RAFT_LOG_OUTPUT=discard
      - APP_ENV=${APP_ENV:-dev}
      - TRACE_OTLP_ENABLED=${TRACE_OTLP_ENABLED:-true}
      - OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-otel-collector:4317}
    ports:
      - "${METADATA_1_PORT:-9090}:9090"
      - "${METADATA_1_RAFT_PORT:-9091}:9091"
      - "${METADATA_1_METRICS_PORT:-9096}:9096"
    volumes:
      - metadata-1-data:/data
    networks:
      - castor-net
    depends_on:
      - otel-collector
    restart: unless-stopped

  metadata-2:
    build:
      context: ../../
      dockerfile: deploy/docker/Dockerfile
      target: metadata-svc
    image: castor-metadata-svc:latest
    container_name: castor-metadata-2
    environment:
      - NODE_ID=${METADATA_2_NODE_ID:-metadata-2}
      - GRPC_ADDR=${METADATA_2_GRPC_ADDR:-:9090}
      - RAFT_ADDR=${METADATA_2_RAFT_ADDR:-metadata-2:9091}
      - METRICS_ADDR=${METADATA_2_METRICS_ADDR:-:9096}
      - DATA_DIR=${METADATA_2_DATA_DIR:-/data}
      - RAFT_BOOTSTRAP=false
      - RAFT_PEERS=${RAFT_PEERS:-metadata-1=metadata-1:9091,metadata-2=metadata-2:9091,metadata-3=metadata-3:9091}
      - RAFT_LOG_OUTPUT=discard
      - APP_ENV=${APP_ENV:-dev}
      - TRACE_OTLP_ENABLED=${TRACE_OTLP_ENABLED:-true}
      - OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-otel-collector:4317}
    ports:
      - "${METADATA_2_PORT:-9092}:9090"
      - "${METADATA_2_METRICS_PORT:-9097}:9096"
    volumes:
      - metadata-2-data:/data
    networks:
      - castor-net
    depends_on:
      - metadata-1
      - otel-collector
    restart: unless-stopped

  metadata-3:
    build:
      context: ../../
      dockerfile: deploy/docker/Dockerfile
      target: metadata-svc
    image: castor-metadata-svc:latest
    container_name: castor-metadata-3
    environment:
      - NODE_ID=${METADATA_3_NODE_ID:-metadata-3}
      - GRPC_ADDR=${METADATA_3_GRPC_ADDR:-:9090}
      - RAFT_ADDR=${METADATA_3_RAFT_ADDR:-metadata-3:9091}
      - METRICS_ADDR=${METADATA_3_METRICS_ADDR:-:9096}
      - DATA_DIR=${METADATA_3_DATA_DIR:-/data}
      - RAFT_BOOTSTRAP=false
      - RAFT_PEERS=${RAFT_PEERS:-metadata-1=metadata-1:9091,metadata-2=metadata-2:9091,metadata-3=metadata-3:9091}
      - RAFT_LOG_OUTPUT=discard
      - APP_ENV=${APP_ENV:-dev}
      - TRACE_OTLP_ENABLED=${TRACE_OTLP_ENABLED:-true}
      - OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-otel-collector:4317}
    ports:
      - "${METADATA_3_PORT:-9094}:9090"
      - "${METADATA_3_METRICS_PORT:-9098}:9096"
    volumes:
      - metadata-3-data:/data
    networks:
      - castor-net
    depends_on:
      - metadata-1
      - otel-collector
    restart: unless-stopped

  # Storage Data Nodes (3 Nodes)
  data-1:
    build:
      context: ../../
      dockerfile: deploy/docker/Dockerfile
      target: data-svc
    image: castor-data-svc:latest
    container_name: castor-data-1
    environment:
      - NODE_ID=${DATA_1_NODE_ID:-data-1}
      - GRPC_ADDR=${DATA_1_GRPC_ADDR:-:9101}
      - METRICS_ADDR=${DATA_1_METRICS_ADDR:-:9104}
      - DATA_DIR=${DATA_1_DATA_DIR:-/data}
      - APP_ENV=${APP_ENV:-dev}
      - TRACE_OTLP_ENABLED=${TRACE_OTLP_ENABLED:-true}
      - OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-otel-collector:4317}
    ports:
      - "${DATA_1_PORT:-9101}:9101"
      - "${DATA_1_METRICS_PORT:-9104}:9104"
    volumes:
      - data-1-data:/data
    networks:
      - castor-net
    depends_on:
      - otel-collector
    restart: unless-stopped

  data-2:
    build:
      context: ../../
      dockerfile: deploy/docker/Dockerfile
      target: data-svc
    image: castor-data-svc:latest
    container_name: castor-data-2
    environment:
      - NODE_ID=${DATA_2_NODE_ID:-data-2}
      - GRPC_ADDR=${DATA_2_GRPC_ADDR:-:9101}
      - METRICS_ADDR=${DATA_2_METRICS_ADDR:-:9104}
      - DATA_DIR=${DATA_2_DATA_DIR:-/data}
      - APP_ENV=${APP_ENV:-dev}
      - TRACE_OTLP_ENABLED=${TRACE_OTLP_ENABLED:-true}
      - OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-otel-collector:4317}
    ports:
      - "${DATA_2_PORT:-9102}:9101"
      - "${DATA_2_METRICS_PORT:-9105}:9104"
    volumes:
      - data-2-data:/data
    networks:
      - castor-net
    depends_on:
      - otel-collector
    restart: unless-stopped

  data-3:
    build:
      context: ../../
      dockerfile: deploy/docker/Dockerfile
      target: data-svc
    image: castor-data-svc:latest
    container_name: castor-data-3
    environment:
      - NODE_ID=${DATA_3_NODE_ID:-data-3}
      - GRPC_ADDR=${DATA_3_GRPC_ADDR:-:9101}
      - METRICS_ADDR=${DATA_3_METRICS_ADDR:-:9104}
      - DATA_DIR=${DATA_3_DATA_DIR:-/data}
      - APP_ENV=${APP_ENV:-dev}
      - TRACE_OTLP_ENABLED=${TRACE_OTLP_ENABLED:-true}
      - OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-otel-collector:4317}
    ports:
      - "${DATA_3_PORT:-9103}:9101"
      - "${DATA_3_METRICS_PORT:-9106}:9104"
    volumes:
      - data-3-data:/data
    networks:
      - castor-net
    depends_on:
      - otel-collector
    restart: unless-stopped

  # castor Gateway
  gateway:
    build:
      context: ../../
      dockerfile: deploy/docker/Dockerfile
      target: gateway-svc
    image: castor-gateway-svc:latest
    container_name: castor-gateway
    environment:
      - S3_ADDR=${S3_ADDR:-:9000}
      - CONSOLE_ADDR=${CONSOLE_ADDR:-:9001}
      - METADATA_ADDR=${METADATA_ADDR:-metadata-1:9090}
      - METADATA_NODES=${METADATA_NODES:-metadata-1:9090,metadata-2:9090,metadata-3:9090}
      - DATA_NODES=${DATA_NODES:-data-1:9101,data-2:9101,data-3:9101}
      - AUTH_ADDR=${AUTH_ADDR:-http://auth-svc:9095}
      - ROOT_ACCESS_KEY_ID=${ROOT_ACCESS_KEY_ID:-admin}
      - ROOT_SECRET_ACCESS_KEY=${ROOT_SECRET_ACCESS_KEY:-admin123}
      - WRITE_QUORUM=${WRITE_QUORUM:-2}
      - CHUNK_SIZE=${CHUNK_SIZE:-4194304}
      - MAX_CONCURRENT_UPLOADS=${MAX_CONCURRENT_UPLOADS:-64}
      - APP_ENV=${APP_ENV:-dev}
      - TRACE_OTLP_ENABLED=${TRACE_OTLP_ENABLED:-true}
      - OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-otel-collector:4317}
    ports:
      - "${S3_PORT:-9000}:9000"
      - "${CONSOLE_PORT:-9001}:9001"
    networks:
      - castor-net
    depends_on:
      - metadata-1
      - data-1
      - data-2
      - data-3
      - auth-svc
      - otel-collector
    restart: unless-stopped

  # PostgreSQL Database for Auth Service
  auth-db:
    image: postgres:17-alpine
    container_name: castor-auth-db
    environment:
      - POSTGRES_DB=${POSTGRES_DB:-castor_auth}
      - POSTGRES_USER=${POSTGRES_USER:-castor}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-castor123}
      - PGDATA=${PGDATA:-/var/lib/postgresql/data/pgdata}
    ports:
      - "${POSTGRES_PORT:-5432}:5432"
    volumes:
      - auth-db-data:/var/lib/postgresql/data
      - ../docker/init-auth-db.sql:/docker-entrypoint-initdb.d/01-init.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-castor} -d ${POSTGRES_DB:-castor_auth}"]
      interval: 3s
      timeout: 3s
      retries: 5
    networks:
      - castor-net
    restart: unless-stopped

  # Auth Service
  auth-svc:
    build:
      context: ../../
      dockerfile: deploy/docker/Dockerfile
      target: auth-svc
    image: castor-auth-svc:latest
    container_name: castor-auth-svc
    environment:
      - APP_ENV=${APP_ENV:-dev}
      - TRACE_OTLP_ENABLED=${TRACE_OTLP_ENABLED:-true}
      - OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT:-otel-collector:4317}
      - AUTH_HTTP_ADDR=${AUTH_HTTP_ADDR:-:9095}
      - AUTH_READ_TIMEOUT=${AUTH_READ_TIMEOUT:-10s}
      - AUTH_WRITE_TIMEOUT=${AUTH_WRITE_TIMEOUT:-10s}
      - AUTH_IDLE_TIMEOUT=${AUTH_IDLE_TIMEOUT:-120s}
      - AUTH_SHUTDOWN_TIMEOUT=${AUTH_SHUTDOWN_TIMEOUT:-10s}
      - AUTH_DATABASE_URL=${AUTH_DATABASE_URL:-postgres://${POSTGRES_USER:-castor}:${POSTGRES_PASSWORD:-castor123}@auth-db:5432/${POSTGRES_DB:-castor_auth}?sslmode=disable}
      - AUTH_DB_MAX_CONNS=${AUTH_DB_MAX_CONNS:-25}
      - AUTH_DB_MIN_CONNS=${AUTH_DB_MIN_CONNS:-5}
      - AUTH_DB_MAX_CONN_LIFETIME=${AUTH_DB_MAX_CONN_LIFETIME:-1h}
      - AUTH_DB_MAX_CONN_IDLE_TIME=${AUTH_DB_MAX_CONN_IDLE_TIME:-30m}
      - AUTH_DB_HEALTH_CHECK_PERIOD=${AUTH_DB_HEALTH_CHECK_PERIOD:-1m}
      - AUTH_DB_CONNECT_TIMEOUT=${AUTH_DB_CONNECT_TIMEOUT:-5s}
      - ADMIN_KEY=${ADMIN_KEY:-castor-cluster-admin-secret}
      - AUTH_BCRYPT_COST=${AUTH_BCRYPT_COST:-12}
      - AUTH_JWT_SECRET=${AUTH_JWT_SECRET:-castor-auth-jwt-super-secret-key-change-in-production}
      - AUTH_JWT_EXPIRY=${AUTH_JWT_EXPIRY:-24h}
    ports:
      - "${AUTH_HTTP_PORT:-9095}:9095"
    depends_on:
      auth-db:
        condition: service_healthy
      otel-collector:
        condition: service_started
    networks:
      - castor-net
    restart: unless-stopped

  # OpenTelemetry Collector (Forwarding to Grafana Cloud / local)
  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.96.0
    container_name: castor-otel-collector
    command: ["--config=/etc/otel-collector-config.yaml"]
    environment:
      - GRAFANA_CLOUD_OTLP_ENDPOINT=${GRAFANA_CLOUD_OTLP_ENDPOINT:-https://otlp-gateway-prod-us-east-0.grafana.net/otlp}
      - GRAFANA_CLOUD_INSTANCE_ID=${GRAFANA_CLOUD_INSTANCE_ID:-}
      - GRAFANA_CLOUD_API_KEY=${GRAFANA_CLOUD_API_KEY:-}
    volumes:
      - ./otel-collector-config.yaml:/etc/otel-collector-config.yaml:ro
    ports:
      - "${OTEL_COLLECTOR_GRPC_PORT:-4317}:4317" # OTLP gRPC receiver
      - "${OTEL_COLLECTOR_HTTP_PORT:-4318}:4318" # OTLP HTTP receiver
    networks:
      - castor-net
    restart: unless-stopped

volumes:
  metadata-1-data:
  metadata-2-data:
  metadata-3-data:
  data-1-data:
  data-2-data:
  data-3-data:
  auth-db-data:

networks:
  castor-net:
    driver: bridge
